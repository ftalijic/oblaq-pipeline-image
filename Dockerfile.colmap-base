# oblaQ COLMAP Base Image — v3
#
# Major update: pinned to COLMAP 4.1.1 (released 2026-07-17, commit a0d785f)
#
# Why 4.1.1 over the previous pinned commit (fff58c71 / ~3.x era):
#
# 1. CASPAR GPU bundle adjustment (-DCASPAR_ENABLED=ON)
#    GPU-accelerated BA backend, 1-2 orders of magnitude faster than Ceres CUDA.
#    Use at runtime with: --BundleAdjustment.backend CASPAR
#    Replaces the cuDSS/Ceres CUDA approach entirely — Caspar is far more powerful.
#
# 2. Native EQUIRECTANGULAR camera model
#    COLMAP now natively supports 360° equirectangular reconstruction without
#    rendering perspective crops first. Use --ImageReader.camera_model EQUIRECTANGULAR
#    in feature extraction — this is the correct model for X5 captures.
#    (Previously this flag was tried but failed at the Nerfstudio stage; now that
#    the camera model is natively supported end-to-end, it should work correctly.)
#
# 3. RANSAC/LORANSAC matching slowdown fix (~4-6x)
#    Fixes a process-global OpenMP critical section that caused exhaustive matching
#    to appear "stuck" at large block sizes — the mysterious block_size=300 hang.
#
# 4. Multi-architecture CUDA build (86=Ampere + 89=Ada Lovelace)
#    One image works on RTX 4090 (Ada) and A100/A40/RTX 3090 (Ampere) pods.
#
# 5. Vocabulary tree included
#    256K word tree baked in at /opt/colmap-vocab/vocab_tree_256K.bin
#    Use with: --VocabTreeMatching.vocab_tree_path /opt/colmap-vocab/vocab_tree_256K.bin
#
# Note: cuDSS support was added in v2 of this Dockerfile but is now superseded
# by Caspar, which is 10-100x faster than Ceres+cuDSS for the same problems.
 
# ============================================================
# STAGE 1: builder — compiles COLMAP, discarded after this stage
# ============================================================
FROM nvidia/cuda:12.4.1-devel-ubuntu22.04 AS builder
 
ENV DEBIAN_FRONTEND=noninteractive
 
RUN apt-get update && apt-get install -y \
    git cmake ninja-build build-essential \
    libboost-program-options-dev libboost-graph-dev libboost-system-dev \
    libeigen3-dev libopenimageio-dev openimageio-tools libmetis-dev \
    libgoogle-glog-dev libgtest-dev libgmock-dev libsqlite3-dev libglew-dev \
    qtbase5-dev libqt5opengl5-dev libcgal-dev libceres-dev \
    libqt5svg5-dev libopencv-dev \
    wget \
    && rm -rf /var/lib/apt/lists/*
 
# CMake fix: apt's 3.22.1 is too old for COLMAP's bundled faiss (needs 3.24+).
RUN cd /tmp && \
    wget https://github.com/Kitware/CMake/releases/download/v3.29.0/cmake-3.29.0-linux-x86_64.tar.gz && \
    tar -xzf cmake-3.29.0-linux-x86_64.tar.gz && \
    mv cmake-3.29.0-linux-x86_64 /opt/cmake-3.29.0 && \
    rm cmake-3.29.0-linux-x86_64.tar.gz
ENV PATH="/opt/cmake-3.29.0/bin:${PATH}"
 
# COLMAP 4.1.1 with Caspar GPU bundle adjustment enabled.
# -DCASPAR_ENABLED=ON: enables Caspar (disabled by default, requires CUDA ≥7.0).
# -DCMAKE_CUDA_ARCHITECTURES="86;89": Ampere + Ada Lovelace (A100/A40/3090 + 4090/4000Ada).
# ninja -j4: faster than -j2 on GitHub Actions runners.
# If runner OOMs during build, fall back to ninja -j2.
RUN cd /root && \
    git clone https://github.com/colmap/colmap.git && \
    cd colmap && \
    git checkout a0d785f && \
    mkdir build && cd build && \
    cmake .. -GNinja \
        -DCUDA_ENABLED=ON \
        -DCASPAR_ENABLED=ON \
        -DCMAKE_CUDA_ARCHITECTURES="86;89" \
        -DCMAKE_INSTALL_PREFIX=/opt/colmap-install \
    && \
    ninja -j4 && \
    ninja install && \
    rm -rf /root/colmap
 
# Vocabulary tree (256K words) baked in for vocab_tree_matcher.
# Faster alternative to exhaustive_matcher for large datasets (1000+ frames).
# Usage: --VocabTreeMatching.vocab_tree_path $COLMAP_VOCAB_TREE
RUN mkdir -p /opt/colmap-vocab && \
    wget -q https://demuc.de/colmap/vocab_tree_flickr100K_words256K.bin \
        -O /opt/colmap-vocab/vocab_tree_256K.bin && \
    echo "Vocab tree: $(ls -lh /opt/colmap-vocab/vocab_tree_256K.bin)"
 
# ============================================================
# STAGE 2: final — clean image, just the finished COLMAP install
# ============================================================
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04
 
ENV DEBIAN_FRONTEND=noninteractive
 
RUN apt-get update && apt-get install -y \
    libboost-program-options-dev libboost-graph-dev libboost-system-dev \
    libopenimageio-dev libmetis-dev \
    libgoogle-glog-dev libsqlite3-dev libglew-dev \
    qtbase5-dev libqt5opengl5-dev libqt5svg5-dev \
    libceres-dev libopencv-dev \
    tmux \
    && rm -rf /var/lib/apt/lists/*
 
COPY --from=builder /opt/colmap-install /opt/colmap-install
COPY --from=builder /opt/colmap-vocab /opt/colmap-vocab
 
ENV PATH="/opt/colmap-install/bin:${PATH}"
ENV COLMAP_VOCAB_TREE="/opt/colmap-vocab/vocab_tree_256K.bin"
 
RUN colmap -h | grep -q "with CUDA" || (echo "COLMAP built WITHOUT CUDA - check build args" && exit 1)
 
WORKDIR /root
CMD ["/bin/bash"]
 
