# oblaQ COLMAP Base Image — v5
#
# Adopts a VERIFIED working Ceres+cuDSS GPU bundle adjustment recipe from
# AWS's own production Gaussian Splatting pipeline (aws-solutions-library-samples/
# guidance-for-open-source-3d-reconstruction-toolbox-for-gaussian-splats-on-aws).
#
# Why this exists: v4's attempt to build Ceres with cuDSS failed — cuDSS 0.8.0
# renamed a type (cudaDataType_t -> cudssDataType_t) that broke the pinned
# Ceres commit, which was written against the OLDER cuDSS API. AWS's own
# production Dockerfile pins the SAME Ceres commit we used, but with cuDSS
# 0.7.1 (pre-rename) instead of 0.8.0 - confirming the diagnosis and giving
# a verified-working version pairing instead of another guess.
#
# ⚠️ MAJOR CHANGE: CUDA version bumped 12.4 -> 13.0 to match AWS's verified
# stack (their cuDSS .deb packages are literally named "-cuda-13", tied to
# this major version). The pipeline image (nvcc install, torch+cu128 pin in
# oblaq_requirements.txt) will need matching updates before it can build
# correctly on top of this base - treat as a separate follow-up, not done
# in this file. TEST THIS BASE IMAGE ALONE FIRST before touching the
# pipeline image, to isolate whether the Ceres+cuDSS fix actually works
# before layering more changes on top.
#
# Source of the verified recipe:
#   github.com/aws-solutions-library-samples/guidance-for-open-source-3d-reconstruction-toolbox-for-gaussian-splats-on-aws
#   (source/container/Dockerfile, retrieved 2026-08-07)
#
# v5 update (2026-08-30): broadened CUDA_ARCHITECTURES to include Volta (70)
# and Hopper (90) so this image works on V100 and H100 pods, not just
# Turing-through-Ada (75;80;86;89). Also swapped the default reference
# BLAS/LAPACK for openblas-pthread in both stages, and added a sane
# OMP_NUM_THREADS default - neither turned out to fix the specific COLMAP
# global-positioning single-core issue investigated that day (root cause
# was GPU VRAM capacity, not CPU threading), but both are still worth
# having: a bare reference BLAS is a bad default for any other CPU-bound
# linear algebra in the pipeline, and OMP_NUM_THREADS=1 silently caps
# every OpenMP-parallel code path in the image.

# ============================================================
# STAGE 1: builder — compiles cuDSS-linked Ceres, then COLMAP against it
# ============================================================
FROM nvidia/cuda:13.0.0-devel-ubuntu22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDSS_VERSION="0.7.1"
ENV CERES_HASH="0ba987acaf9e8674070f116ed624edf017d2b630"
# Broadened to match AWS's verified architecture list (Turing through Ada Lovelace),
# plus Volta (70, V100) and Hopper (90, H100) for full RunPod GPU-tier coverage.
ENV CUDA_ARCHITECTURES="70;75;80;86;89;90"
ENV NINJA_JOBS=2

RUN apt-get update && apt-get install -y \
    git cmake ninja-build build-essential \
    libboost-program-options-dev libboost-graph-dev libboost-system-dev \
    libeigen3-dev libopenimageio-dev openimageio-tools libmetis-dev \
    libgoogle-glog-dev libgtest-dev libgmock-dev libsqlite3-dev libglew-dev \
    qtbase5-dev libqt5opengl5-dev libcgal-dev \
    libqt5svg5-dev libopencv-dev \
    libsuitesparse-dev \
    wget \
    && rm -rf /var/lib/apt/lists/*

# CMake fix: apt's default is too old for COLMAP's bundled faiss (needs 3.24+).
RUN cd /tmp && \
    wget https://github.com/Kitware/CMake/releases/download/v3.29.0/cmake-3.29.0-linux-x86_64.tar.gz && \
    tar -xzf cmake-3.29.0-linux-x86_64.tar.gz && \
    mv cmake-3.29.0-linux-x86_64 /opt/cmake-3.29.0 && \
    rm cmake-3.29.0-linux-x86_64.tar.gz
ENV PATH="/opt/cmake-3.29.0/bin:${PATH}"

# Swap the default reference BLAS/LAPACK for a properly threaded OpenBLAS
# build BEFORE Ceres links against it, so the build-time link picks up the
# threaded variant instead of the single-threaded Netlib reference impl
# apt installs by default.
RUN apt-get update && apt-get install -y libopenblas0-pthread && \
    rm -rf /var/lib/apt/lists/* && \
    ln -sf /usr/lib/x86_64-linux-gnu/openblas-pthread/libopenblas.so.0 /usr/lib/x86_64-linux-gnu/libblas.so.3 && \
    ln -sf /usr/lib/x86_64-linux-gnu/openblas-pthread/libopenblas.so.0 /usr/lib/x86_64-linux-gnu/liblapack.so.3 && \
    ldconfig

# --- cuDSS 0.7.1 via NVIDIA's official .deb local installer ---
# (v4 used a raw tarball from the redist archive, which pulled 0.8.0 - the
# broken pairing. This is NVIDIA's officially documented install method,
# and the exact version AWS's production pipeline uses.)
RUN wget https://developer.download.nvidia.com/compute/cudss/${CUDSS_VERSION}/local_installers/cudss-local-repo-ubuntu2204-${CUDSS_VERSION}_${CUDSS_VERSION}-1_amd64.deb \
    && dpkg -i cudss-local-repo-ubuntu2204-${CUDSS_VERSION}_${CUDSS_VERSION}-1_amd64.deb \
    && cp /var/cudss-local-repo-ubuntu2204-${CUDSS_VERSION}/cudss-*-keyring.gpg /usr/share/keyrings/ \
    && apt-get update \
    && apt-get install -y \
        /var/cudss-local-repo-ubuntu2204-${CUDSS_VERSION}/libcudss0-cuda-13_${CUDSS_VERSION}.4-1_amd64.deb \
        /var/cudss-local-repo-ubuntu2204-${CUDSS_VERSION}/libcudss0-dev-cuda-13_${CUDSS_VERSION}.4-1_amd64.deb \
        /var/cudss-local-repo-ubuntu2204-${CUDSS_VERSION}/libcudss0-static-cuda-13_${CUDSS_VERSION}.4-1_amd64.deb \
    && apt-mark hold libcudss0-cuda-13 libcudss0-dev-cuda-13 libcudss0-static-cuda-13 \
    && echo "/usr/lib/x86_64-linux-gnu/libcudss/13" > /etc/ld.so.conf.d/cudss.conf \
    && ldconfig \
    && ln -sf /usr/include/libcudss/13/cudss.h /usr/include/cudss.h \
    && ln -sf /usr/include/libcudss/13/cudss_threading_interface.h /usr/include/cudss_threading_interface.h \
    && ln -sf /usr/include/libcudss/13/cudss_distributed_interface.h /usr/include/cudss_distributed_interface.h

ENV cudss_DIR=/usr/lib/x86_64-linux-gnu/libcudss/13/cmake/cudss

# --- Ceres Solver, built from source with CUDA + cuDSS ---
# Same commit as v4 (proven correct - only the cuDSS version was wrong).
# -DUSE_CUDSS=ON added explicitly (v4 was missing this - relied on
# auto-detection, which may be why the type mismatch wasn't caught until
# actual compilation rather than at CMake configure time).
RUN git clone --recurse-submodules https://github.com/ceres-solver/ceres-solver /root/ceres-solver && \
    cd /root/ceres-solver && \
    git reset --hard ${CERES_HASH} && \
    mkdir build && cd build && \
    cmake .. -GNinja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCUDA=ON \
        -DUSE_CUDSS=ON \
        -DCUDA_ARCHITECTURES="${CUDA_ARCHITECTURES}" \
        -Dcudss_DIR="${cudss_DIR}" \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DBUILD_TESTING=OFF \
        -DBUILD_EXAMPLES=OFF \
        2>&1 | tee /tmp/ceres_cmake_log.txt && \
    grep -qi "cudss" /tmp/ceres_cmake_log.txt || \
        (echo "BUILD FAILED: cuDSS not found by Ceres CMake configuration. Check /tmp/ceres_cmake_log.txt" && exit 1) && \
    ninja -j${NINJA_JOBS} && \
    ninja install && \
    rm -rf /root/ceres-solver

ENV Ceres_DIR=/usr/local/lib/cmake/Ceres

# --- COLMAP 4.1.1, linked against the CUDA+cuDSS Ceres build above ---
# Trying 4.1.1 (native equirectangular reconstruction, RANSAC fix) directly
# rather than matching AWS's COLMAP 4.0.4 - if this fails, fall back to
# 4.0.4 to isolate whether the issue is COLMAP-version-specific.
# -Dcudss_DIR passed directly to COLMAP too (not just via Ceres_DIR) -
# matches AWS's pattern, COLMAP's own CMake may need it independently.
RUN cd /root && \
    git clone https://github.com/colmap/colmap.git && \
    cd colmap && \
    git checkout a0d785f && \
    mkdir build && cd build && \
    cmake .. -GNinja \
        -DCUDA_ENABLED=ON \
        -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCHITECTURES}" \
        -DCMAKE_INSTALL_PREFIX=/opt/colmap-install \
        -DFETCH_CERES=OFF \
        -DCeres_DIR="${Ceres_DIR}" \
        -Dcudss_DIR="${cudss_DIR}" \
        2>&1 | tee /tmp/colmap_cmake_log.txt && \
    grep -qi "Found Ceres" /tmp/colmap_cmake_log.txt || \
        (echo "BUILD FAILED: COLMAP did not find the custom Ceres build. Check /tmp/colmap_cmake_log.txt" && exit 1) && \
    ninja -j${NINJA_JOBS} && \
    ninja install && \
    rm -rf /root/colmap

# Vocabulary tree (256K words) for vocab_tree_matcher.
RUN mkdir -p /opt/colmap-vocab && \
    wget -q https://demuc.de/colmap/vocab_tree_flickr100K_words256K.bin \
        -O /opt/colmap-vocab/vocab_tree_256K.bin && \
    echo "Vocab tree: $(ls -lh /opt/colmap-vocab/vocab_tree_256K.bin)"

# ============================================================
# STAGE 2: final — clean image with COLMAP + the Ceres/cuDSS it needs at runtime
# ============================================================
FROM nvidia/cuda:13.0.0-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
# Defensive default - nothing in this image should silently inherit a
# single-thread cap from a base image.
ENV OMP_NUM_THREADS=64

RUN apt-get update && apt-get install -y \
    libboost-program-options-dev libboost-graph-dev libboost-system-dev \
    libopenimageio-dev libmetis-dev \
    libgoogle-glog-dev libsqlite3-dev libglew-dev \
    qtbase5-dev libqt5opengl5-dev libqt5svg5-dev \
    libopencv-dev \
    libsuitesparse-dev \
    wget tmux \
    && rm -rf /var/lib/apt/lists/*

# Same OpenBLAS-pthread swap as the builder stage - this is what COLMAP
# actually dynamically links against at runtime, so it needs to match.
RUN apt-get update && apt-get install -y libopenblas0-pthread && \
    rm -rf /var/lib/apt/lists/* && \
    ln -sf /usr/lib/x86_64-linux-gnu/openblas-pthread/libopenblas.so.0 /usr/lib/x86_64-linux-gnu/libblas.so.3 && \
    ln -sf /usr/lib/x86_64-linux-gnu/openblas-pthread/libopenblas.so.0 /usr/lib/x86_64-linux-gnu/liblapack.so.3 && \
    ldconfig

# Re-register cuDSS runtime library in the clean final stage (needed for
# COLMAP to dynamically link against it at runtime, not just at build time).
ENV CUDSS_VERSION="0.7.1"
RUN wget https://developer.download.nvidia.com/compute/cudss/${CUDSS_VERSION}/local_installers/cudss-local-repo-ubuntu2204-${CUDSS_VERSION}_${CUDSS_VERSION}-1_amd64.deb \
    && dpkg -i cudss-local-repo-ubuntu2204-${CUDSS_VERSION}_${CUDSS_VERSION}-1_amd64.deb \
    && cp /var/cudss-local-repo-ubuntu2204-${CUDSS_VERSION}/cudss-*-keyring.gpg /usr/share/keyrings/ \
    && apt-get update \
    && apt-get install -y \
        /var/cudss-local-repo-ubuntu2204-${CUDSS_VERSION}/libcudss0-cuda-13_${CUDSS_VERSION}.4-1_amd64.deb \
    && echo "/usr/lib/x86_64-linux-gnu/libcudss/13" > /etc/ld.so.conf.d/cudss.conf \
    && ldconfig \
    && rm -f cudss-local-repo-ubuntu2204-${CUDSS_VERSION}_${CUDSS_VERSION}-1_amd64.deb \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/colmap-install /opt/colmap-install
COPY --from=builder /opt/colmap-vocab /opt/colmap-vocab
COPY --from=builder /usr/local/lib /usr/local/lib
RUN ldconfig

ENV PATH="/opt/colmap-install/bin:${PATH}"
ENV COLMAP_VOCAB_TREE="/opt/colmap-vocab/vocab_tree_256K.bin"

RUN colmap -h | grep -q "with CUDA" || (echo "COLMAP built WITHOUT CUDA - check build args" && exit 1)
